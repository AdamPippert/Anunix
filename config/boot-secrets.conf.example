# Local boot secrets — copy to config/boot-secrets.conf and fill in.
#
# config/boot-secrets.conf is gitignored and MUST stay that way. A kernel
# built with it carries these values in plaintext inside the image, so treat
# any ISO or EFI binary built this way as a secret itself: do not publish it,
# do not attach it to a release.
#
# Only these two names are accepted. Anything else is a build error.

wifi-ssid = YourNetwork
wifi-pass = YourPassword
